#!/usr/bin/env bash

set -euo pipefail

DOTFILES="$HOME/dotfiles"

DEFAULT_PACKAGES=(bash npm git prettier nvim-minimal tmux aerospace sketchybar jankyborders lf gh ghostty)

command -v stow &>/dev/null || brew install stow

cd "$DOTFILES"

if [[ $# -eq 0 ]]; then
  pkgs=()
  for pkg in "${DEFAULT_PACKAGES[@]}"; do
    # Skip git if .gitconfig is not present (fresh machine)
    [[ "$pkg" == "git" && ! -f "$DOTFILES/git/.gitconfig" ]] && continue
    pkgs+=("$pkg")
  done
  stow -t ~ "${pkgs[@]}"
else
  stow -t ~ "$@"
fi
